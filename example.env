# openats example environment file
#
# Copy this file to `.env` in the project root to use it:
#
#     cp example.env .env
#
# Only the literal filename `.env` is read (dotenv.load_dotenv() in
# src/cli.py and src/app.py), so this example file is never loaded as-is.
#
# EVERY VALUE HERE IS OPTIONAL. The collection pipeline runs with no .env
# at all; each block below is only needed for the specific collectors it
# documents.

# --- Browserbase -------------------------------------------------------------
# Remote browser sessions for the browser-required collectors (Meta, Tesla)
# and for the Avature 406-block fallback. Without these the collectors log a
# warning and skip instead of failing.
OPENATS_USE_BROWSERBASE=1
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Emergency kill-switch for every Browserbase path, including the Avature
# fallback. Truthy values: 1, true, yes, on.
# OPENATS_DISABLE_BROWSERBASE=1

# --- USAJOBS -----------------------------------------------------------------
# Required only when collecting USAJOBS; register at
# https://developer.usajobs.gov for a free key.
USAJOBS_API_KEY=

# Optional. USAJOBS expects an email address in the User-Agent per their TOS.
USAJOBS_USER_AGENT=you@example.com

# --- Wellfound ---------------------------------------------------------------
# Required only when collecting Wellfound (Firecrawl-backed scraping).
FIRECRAWL_API_KEY=

# --- Proxy (optional) --------------------------------------------------------
# Four-colon shape, used by the jobs.ch, ProgramaThor, and cloakbrowser /
# Tesla paths. Set only when you need a non-local exit IP.
# PROXY=http://host:port:user:pass

# --- Tests -------------------------------------------------------------------
# Opt-in live end-to-end tests hit real third-party sites; they skip by
# default in CI.
# OPENATS_LIVE_E2E=1
